generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Status {
  PENDING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

model User {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  email           String   @unique
  mobile          String   @unique
  password        String
  name            String
  role            Role     @default(PATIENT)
  isDetailsFilled Boolean  @default(false)
  
  // Doctor specific
  specialty       String?
  licenseNumber   String?
  experience      Int?
  
  // Patient specific
  age             Int?
  gender          String?
  medicalHistory  String?

  createdAt       DateTime @default(now())

  patientAppointments Appointment[] @relation("Patient")
  doctorAppointments  Appointment[] @relation("Doctor")
  chatSessions        ChatSession[]
}

model ChatSession {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id])
  title       String?
  symptoms    String[]
  description String?
  images      String[]  // Base64 or URLs
  diagnosis   Json?     // Storing the structured AI diagnosis
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId String      @db.ObjectId
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
  role          String      // "user" or "assistant"
  content       String
  createdAt     DateTime    @default(now())
}

model Appointment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String   @db.ObjectId
  patient       User     @relation("Patient", fields: [patientId], references: [id])
  
  doctorId      String?  @db.ObjectId
  doctor        User?    @relation("Doctor", fields: [doctorId], references: [id])

  symptoms      String
  aiDiagnosis   String
  severity      Severity @default(LOW)
  status        Status   @default(PENDING)
  
  createdAt     DateTime @default(now())
}
